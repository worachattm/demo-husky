#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
HASH=$(git log -1 --format="%h" 2>/dev/null)
MSG=$(git log -1 --format="%s" 2>/dev/null)

echo ""
echo "╔════════════════════════════════════════╗"
echo "║         ✅  Commit Successful!          ║"
echo "╚════════════════════════════════════════╝"
echo ""
echo "  🌿 Branch  : $BRANCH"
echo "  🔖 Hash    : $HASH"
echo "  💬 Message : $MSG"
echo ""
echo "  🚀 Keep up the good work!"
echo ""
