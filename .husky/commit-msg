#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

echo "$commit_msg"

# Conventional Commits: type(scope): description
pattern='^\[[A-Z][A-Z0-9]*-[0-9]+\] (feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)\(.+\): .+'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "   Expected:[<ticket>] <type>(<scope>): <description>"
  echo "   Example:[KBOLAPP2-1] feat(auth): add JWT refresh token"
  echo "   Example:[KBOLAPP2-1] fix(order): handle null customer id"
  echo ""
  echo "   Types: feat | fix | docs | style | refactor | test | chore | perf | ci | build | revert"
  exit 1
fi
